# Secrets and credentials — never commit
.env
.env.*
*.key
*.pem
*token*
*secret*
credentials/
.creds/

# Raw/large datasets — do not track unless license explicitly permits redistribution
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
*.egg
