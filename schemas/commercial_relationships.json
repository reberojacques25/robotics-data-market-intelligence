{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "commercial_relationships",
  "description": "Buyer-supplier relationships in the robotics data market",
  "type": "object",
  "required": [
    "relationship_id",
    "buyer_organization_id",
    "relationship_type",
    "status",
    "confidence_score"
  ],
  "properties": {
    "relationship_id": {
      "type": "string"
    },
    "buyer_organization_id": {
      "type": "string"
    },
    "supplier_organization_id": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "purchase",
        "license",
        "commissioned_collection",
        "strategic_partnership",
        "research_collaboration",
        "unknown",
        "data_services_offering"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "reported",
        "suspected",
        "disproven"
      ]
    },
    "contract_date": {
      "type": "string",
      "format": "date"
    },
    "value_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "data_scope": {
      "type": "string"
    },
    "evidence_event_id": {
      "type": "string"
    },
    "confidence_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "notes": {
      "type": "string"
    }
  }
}